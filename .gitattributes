# STN-LABZ repository baseline
# Default text normalization
* text=auto eol=lf

# Windows command files
*.bat text eol=crlf
*.cmd text eol=crlf

# Source and text formats
*.c text eol=lf
*.h text eol=lf
*.php text eol=lf
*.pl text eol=lf
*.go text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf

# Binary formats
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
